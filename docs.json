{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Lanten Help Centre",
  "description": "Get the most out of Lanten — the AI email co-pilot for letting agents, inside Outlook.",
  "colors": {
    "primary": "#5A5FD8",
    "light": "#8B8FE8",
    "dark": "#46505D"
  },
  "appearance": {
    "default": "light"
  },
  "icons": {
    "library": "lucide"
  },
  "fonts": {
    "heading": {
      "family": "Newsreader"
    },
    "body": {
      "family": "Hanken Grotesk"
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/lanten.png",
    "dark": "/logo/lanten.png",
    "href": "https://lanten.ai"
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "pages": [
          "getting-started/what-is-lanten",
          "getting-started/quickstart",
          "getting-started/pin-lanten"
        ]
      },
      {
        "group": "Setup",
        "pages": [
          "setup/connect-outlook",
          "setup/connect-street",
          "setup/email-sync",
          "setup/permissions"
        ]
      },
      {
        "group": "Using Lanten",
        "pages": [
          "using-lanten/street-records",
          "using-lanten/linked-threads",
          "using-lanten/summaries",
          "using-lanten/suggested-actions",
          "using-lanten/tasks-and-notes",
          "using-lanten/tags"
        ]
      },
      {
        "group": "Team & billing",
        "pages": [
          "team-billing/invite-team",
          "team-billing/settings",
          "team-billing/subscription"
        ]
      },
      {
        "group": "Outlook compatibility",
        "pages": [
          "outlook/new-vs-classic",
          "outlook/mobile",
          "outlook/shared-inboxes",
          "outlook/reading-pane-actions"
        ]
      },
      {
        "group": "Troubleshooting",
        "pages": [
          "troubleshooting/add-in-not-showing",
          "troubleshooting/it-admins"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Sign in",
        "href": "https://app.lanten.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Register for free",
      "href": "https://app.lanten.ai/signup"
    }
  },
  "footer": {
    "socials": {
      "website": "https://lanten.ai"
    }
  }
}
